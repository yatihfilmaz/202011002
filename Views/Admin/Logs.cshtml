@model List<project.Models.SystemLog>
@{ 
    ViewData["Title"] = "Sistem Logları"; 
    // Controller'dan gelen liste
    var actionTypes = ViewBag.ActionTypes as List<string>;
    var selectedType = ViewBag.SelectedActionType as string;
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-1"><i class="bi bi-file-earmark-code text-primary"></i> Sistem Logları</h3>
            <p class="text-muted mb-0">Platform üzerindeki tüm erişim ve sistem aktiviteleri burada kayıt altına alınır.</p>
        </div>
        <div>
            <span class="badge bg-secondary fs-6">Toplam: @Model.Count Kayıt</span>
        </div>
    </div>
    
    <div class="card shadow-sm border-0 mb-3 bg-light">
        <div class="card-body py-3">
            <form asp-action="Logs" method="get" class="row gx-2 align-items-center">
                <div class="col-auto">
                    <label class="fw-bold text-muted small"><i class="bi bi-filter"></i> Log Türüne Göre Filtrele:</label>
                </div>
                <div class="col-md-4 col-sm-6">
                    <select name="actionType" class="form-select" onchange="this.form.submit()">
                        <option value="">-- Tüm Loglar (Filtresiz) --</option>
                        @if (actionTypes != null)
                        {
                            foreach (var type in actionTypes)
                            {
                                if (type == selectedType)
                                {
                                    <option value="@type" selected>@type</option>
                                }
                                else
                                {
                                    <option value="@type">@type</option>
                                }
                            }
                        }
                    </select>
                </div>
                @if (!string.IsNullOrEmpty(selectedType))
                {
                    <div class="col-auto">
                        <a asp-action="Logs" class="btn btn-outline-danger btn-sm" title="Filtreyi Temizle">
                            <i class="bi bi-x-circle"></i> Temizle
                        </a>
                    </div>
                }
            </form>
        </div>
    </div>
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Tarih (Timestamp)</th>
                        <th>Kullanıcı (User)</th>
                        <th>Aksiyon Tipi</th>
                        <th>Detay (Description)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                <i class="bi bi-search fs-3"></i>
                                <p class="mb-0 mt-2">Seçili kritere uygun log kaydı bulunamadı.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var log in Model)
                        {
                            <tr>
                                <td class="text-muted" style="white-space: nowrap;">@log.Timestamp?.ToString("dd.MM.yyyy HH:mm:ss")</td>
                                <td>
                                    <span class="fw-bold">@(log.User?.FullName ?? "SİSTEM")</span> <br/>
                                    <small class="text-muted fw-normal">ID: @(log.UserId?.ToString() ?? "-")</small>
                                </td>
                                <td>
                                    <span class="badge @(log.ActionType.Contains("Hatalı") || log.ActionType.Contains("Engellendi") ? "bg-danger" : (log.ActionType.Contains("Başarılı") ? "bg-success" : "bg-primary"))">
                                        @log.ActionType
                                    </span>
                                </td>
                                <td class="text-wrap">@log.Description</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>