@model IEnumerable<project.Models.MenuItem>
@{
    ViewData["Title"] = "Menü Yönetimi";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-egg-fried"></i> Menü Yönetimi</h2>
        <a asp-action="Create" class="btn btn-primary fw-bold">
            <i class="bi bi-plus-lg"></i> Yeni Yemek Ekle
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="card shadow">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
    <thead class="table-dark">
        <tr>
            <th>Görsel</th>
            <th>Yemek Adı</th>
            <th>Kategori</th> <th>Fiyat</th>
            <th>Stok</th>
            <th>Durum</th>
            <th class="text-center">İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="align-middle">
                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/default-food.png" : item.ImageUrl)" 
                         style="width: 50px; height: 50px; object-fit: cover; border-radius: 5px;" />
                </td>
                <td class="align-middle fw-bold">@item.Title</td>
                
                <td class="align-middle">
                    @if (item.Category != null)
                    {
                        <span class="badge bg-secondary">@item.Category.Name</span>
                    }
                    else
                    {
                        <span class="text-muted fst-italic">Kategorisiz</span>
                    }
                </td>
                
                <td class="align-middle">@item.Price.ToString("C2")</td>
                <td class="align-middle">
                    <span class="badge @(item.StockQuantity < 10 ? "bg-warning text-dark" : "bg-info")">
                        @item.StockQuantity Porsiyon
                    </span>
                </td>
                <td class="align-middle">
                    @if (item.IsActive == true)
                    {
                        <span class="badge bg-success">Satışta</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Pasif</span>
                    }
                </td>
                <td class="text-center align-middle">
                    <a asp-action="Edit" asp-route-id="@item.ItemId" class="btn btn-outline-secondary btn-sm">Düzenle</a>
                    <a asp-action="ManageCustomizations" asp-controller="Caterer" asp-route-id="@item.ItemId" class="btn btn-sm btn-info shadow-sm text-white">
                        <i class="bi bi-list-check"></i> Seçenekleri Yönet
                    </a>
                    <form asp-action="Delete" asp-route-id="@item.ItemId" method="post" class="d-inline" onsubmit="return confirm('Bu yemeği silmek istediğinize emin misiniz?');">
                        <button type="submit" class="btn btn-outline-danger btn-sm">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
        </div>
    </div>
</div>