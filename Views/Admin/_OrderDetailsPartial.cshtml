@model project.Models.Order

<div class="modal-header bg-dark text-white">
    <h5 class="modal-title fw-bold"><i class="bi bi-receipt"></i> Sipariş Bilgileri (#@Model.OrderId)</h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
</div>
<div class="modal-body p-4">
    
    <div class="row mb-3">
        <div class="col-sm-6 mb-3 mb-sm-0">
            <h6 class="text-muted small fw-bold text-uppercase border-bottom pb-1">Müşteri Bilgileri</h6>
            <p class="mb-1 fw-bold text-dark"><i class="bi bi-person-fill text-secondary"></i> @Model.User?.FullName</p>
            <p class="mb-0 text-muted small"><i class="bi bi-envelope-fill text-secondary"></i> @Model.User?.Email</p>
        </div>
        <div class="col-sm-6 text-sm-end">
            <h6 class="text-muted small fw-bold text-uppercase border-bottom pb-1">Tedarikçi (Restoran)</h6>
            <p class="mb-1 fw-bold text-dark"><i class="bi bi-shop text-secondary"></i> @Model.Caterer?.FullName</p>
            <p class="mb-0 text-muted small"><i class="bi bi-calendar-event text-secondary"></i> Tarih: @Model.OrderDate?.ToString("dd.MM.yyyy - HH:mm")</p>
        </div>
    </div>

    <div class="alert alert-light border d-flex justify-content-between align-items-center p-3 my-3 bg-white">
        <div>
            <span class="text-muted small d-block mb-1 fw-bold">Sipariş Durumu</span>
            @{
                var badgeColor = Model.Status == "Tamamlandı" ? "bg-success" : (Model.Status == "İptal Edildi" ? "bg-danger" : "bg-warning text-dark");
            }
            <span class="badge @badgeColor fs-6 px-3">@Model.Status</span>
        </div>
        <div class="text-end">
            <span class="text-muted small d-block mb-1 fw-bold">Genel Toplam</span>
            <span class="fs-4 fw-bold text-success">@Model.TotalAmount.ToString("C2")</span>
        </div>
    </div>

    <h6 class="fw-bold text-secondary mb-3 mt-4"><i class="bi bi-egg-fried text-primary"></i> Sipariş İçeriği</h6>
    <div class="table-responsive">
        <table class="table table-bordered align-middle">
            <thead class="table-light text-secondary small text-uppercase">
                <tr>
                    <th>Yemek Tanımı</th>
                    <th class="text-center" style="width: 80px;">Adet</th>
                    <th class="text-end" style="width: 130px;">Birim Fiyat</th>
                    <th class="text-end" style="width: 130px;">Toplam</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderItems)
                {
                    <tr>
                        <td>
                            <span class="fw-bold text-dark d-block">@item.Item?.Title</span>
                            
                            @if (item.OrderItemOptions != null && item.OrderItemOptions.Any())
                            {
                                <div class="small text-muted mt-1 ps-2 border-start border-2 border-warning bg-light p-1 rounded">
                                    <span class="small d-block text-uppercase text-muted fw-bold">Seçilen Ekstralar:</span>
                                    @string.Join(", ", item.OrderItemOptions.Select(o => $"{o.Option?.Name} (+{o.Option?.PriceChange:C2})"))
                                </div>
                            }
                        </td>
                        <td class="text-center fw-bold text-dark">@item.Quantity</td>
                        <td class="text-end text-muted">@item.UnitPrice.ToString("C2")</td>
                        <td class="text-end fw-bold text-dark">@((item.Quantity * item.UnitPrice).ToString("C2"))</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<div class="modal-footer bg-light py-2">
    <button type="button" class="btn btn-secondary fw-bold px-4" data-bs-dismiss="modal">Kapat</button>
</div>