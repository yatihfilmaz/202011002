@model project.Models.MenuItem
@{
ViewData["Title"] = "Yeni Yemek Ekle";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white fw-bold py-3">
                    <i class="bi bi-plus-circle"></i> Yeni Yemek / Menü Ekle
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Title" class="form-label fw-bold">Yemek Adı</label>
                                <input asp-for="Title" class="form-control" placeholder="Örn: Zeytinyağlı Enginar" required />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="CategoryId" class="form-label fw-bold">Kategori</label>
                                <div class="input-group">
                                    <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories" id="categorySelect" required>
                                        <option value="">-- Kategori Seçin --</option>
                                    </select>
                                    <button type="button" class="btn btn-outline-primary fw-bold" data-bs-toggle="modal" data-bs-target="#addCategoryModal" title="Yeni Kategori Ekle">
                                        <i class="bi bi-plus-lg"></i>
                                    </button>
                                    <button type="button" class="btn btn-outline-danger fw-bold" onclick="deleteSelectedCategory()" title="Seçili Kategoriyi Sil">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold">İçerik & Açıklama</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Yemeğin içeriği, malzemeleri vb." required></textarea>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label asp-for="Price" class="form-label fw-bold">Fiyat (₺)</label>
                                <input asp-for="Price" type="number" step="0.01" class="form-control" required />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="StockQuantity" class="form-label fw-bold">Stok Adedi</label>
                                <input asp-for="StockQuantity" type="number" class="form-control" required />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="ImageUrl" class="form-label fw-bold">Resim Linki (URL)</label>
                                <input asp-for="ImageUrl" class="form-control" placeholder="http://..." />
                            </div>
                        </div>

                        <div class="mb-4 bg-light p-3 border rounded">
                            <div class="form-check form-switch fs-5 mb-0">
                                <input class="form-check-input" type="checkbox" id="IsActiveSwitch" name="IsActive" value="true" checked style="cursor:pointer;">
                                <input type="hidden" name="IsActive" value="false" />
                                <label class="form-check-label fw-bold text-success" for="IsActiveSwitch" style="cursor:pointer;">
                                    Müşterilere Göster
                                </label>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary fw-bold">
                                <i class="bi bi-arrow-left"></i> Vazgeç
                            </a>
                            <button type="submit" class="btn btn-success fw-bold px-4">
                                <i class="bi bi-save"></i> Kaydet ve Yayınla
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content shadow border-0">
            <div class="modal-header bg-primary text-white py-2">
                <h6 class="modal-title fw-bold"><i class="bi bi-tags"></i> Yeni Kategori</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-3">
                <label class="form-label fw-bold small text-muted">Kategori Adı</label>
                <input type="text" id="newCategoryName" class="form-control" placeholder="Örn: Tatlılar, İçecekler..." />
                <div id="categoryError" class="text-danger small mt-1 d-none">Lütfen kategori adını girin.</div>
            </div>
            <div class="modal-footer p-2 bg-light">
                <button type="button" class="btn btn-sm btn-secondary fw-bold" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-sm btn-primary fw-bold" onclick="saveNewCategory()">Kaydet</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Yeni Kategori Kaydetme
    function saveNewCategory() {
        var categoryName = $("#newCategoryName").val().trim();
        if (!categoryName) {
            $("#categoryError").removeClass("d-none");
            return;
        }
        $("#categoryError").addClass("d-none");

        $.post("/Caterer/AddCategoryAjax", { categoryName: categoryName }, function (data) {
            if (data.success) {
                var newOption = new Option(data.name, data.id, true, true);
                $("#categorySelect").append(newOption).trigger('change');
                $("#addCategoryModal").modal('hide');
                $("#newCategoryName").val("");
            } else {
                alert(data.message);
            }
        });
    }

    // Seçili Kategoriyi Silme
    function deleteSelectedCategory() {
        var selectedId = $("#categorySelect").val();
        if (!selectedId) {
            alert("Lütfen silmek için önce listeden bir kategori seçin.");
            return;
        }

        if (confirm("Seçili kategoriyi silmek istediğinize emin misiniz? (İçinde yemek varsa silinemez)")) {
            $.post("/Caterer/DeleteCategoryAjax", { categoryId: selectedId }, function (data) {
                if (data.success) {
                    $("#categorySelect option[value='" + selectedId + "']").remove();
                    alert("Kategori başarıyla silindi.");
                } else {
                    alert(data.message);
                }
            }).fail(function () {
                alert("Sunucu ile iletişim hatası.");
            });
        }
    }
</script>
}