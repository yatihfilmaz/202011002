@model IEnumerable<project.Models.CartItem>

@{
    ViewData["Title"] = "Sepetim";
    
    // Sepetin genel toplamını hesaplıyoruz (Yemek Fiyatı + Seçenek Fiyatları) * Adet
    decimal grandTotal = Model?.Sum(item => 
        (item.Price + (item.SelectedCustomizations?.Sum(c => c.PriceChange) ?? 0)) * item.Quantity
    ) ?? 0;
}

<div class="container mt-5">
    <h2 class="mb-4 text-primary"><i class="bi bi-cart3"></i> Sepetim</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5 bg-light rounded shadow-sm border">
            <i class="bi bi-cart-x text-muted" style="font-size: 4rem;"></i>
            <h4 class="mt-3 text-secondary">Sepetiniz şu an boş.</h4>
            <p class="text-muted">Hemen menüye dönüp lezzetli yemekler ekleyebilirsiniz!</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3 px-4">Menüye Dön</a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-8 mb-4">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th scope="col" class="ps-4">Ürün</th>
                                        <th scope="col" class="text-center">Fiyat</th>
                                        <th scope="col" class="text-center">Adet</th>
                                        <th scope="col" class="text-center">Toplam</th>
                                        <th scope="col" class="text-end pe-4">İşlem</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        // 1. Ekstra özelliklerin fiyat farkını topla
                                        decimal extrasTotal = item.SelectedCustomizations?.Sum(c => c.PriceChange) ?? 0;
                                        // 2. Yemeğin güncel birim fiyatını bul (Taban + Ekstralar)
                                        decimal unitPrice = item.Price + extrasTotal;
                                        // 3. Satır toplamı
                                        decimal rowTotal = unitPrice * item.Quantity;

                                        <tr>
                                            <td class="ps-4 py-3">
                                                <div class="d-flex align-items-center">
                                                    <img src="@item.ImageUrl" alt="@item.Title" class="rounded object-fit-cover me-3 shadow-sm" style="width: 65px; height: 65px;">
                                                    <div>
                                                        <h6 class="mb-1 fw-bold text-dark">@item.Title</h6>
                                                        
                                                        @if (item.SelectedCustomizations != null && item.SelectedCustomizations.Any())
                                                        {
                                                            <ul class="list-unstyled mb-0 mt-1">
                                                                @foreach (var opt in item.SelectedCustomizations)
                                                                {
                                                                    <li class="text-secondary" style="font-size: 0.85rem;">
                                                                        <i class="bi bi-chevron-right" style="font-size: 0.7rem;"></i> @opt.Name 
                                                                        @if (opt.PriceChange > 0)
                                                                        {
                                                                            <span class="text-success fw-medium">(+@opt.PriceChange.ToString("C2"))</span>
                                                                        }
                                                                        else if (opt.PriceChange < 0)
                                                                        {
                                                                            <span class="text-danger fw-medium">(@opt.PriceChange.ToString("C2"))</span>
                                                                        }
                                                                    </li>
                                                                }
                                                            </ul>
                                                        }
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-center">
                                                <span class="fw-medium text-dark">@unitPrice.ToString("C2")</span>
                                                @if (extrasTotal != 0)
                                                {
                                                    <div class="text-muted mt-1" style="font-size: 0.75rem;">(Taban: @item.Price.ToString("C2"))</div>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3 py-2 fs-6">@item.Quantity</span>
                                            </td>
                                            <td class="text-center fw-bold text-primary">
                                                @rowTotal.ToString("C2")
                                            </td>
                                            <td class="text-end pe-4">
                                                <form asp-controller="Cart" asp-action="RemoveFromCart" method="post" class="d-inline">
                                                    <input type="hidden" name="itemId" value="@item.ItemId" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Sepetten Çıkar">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                
                <div class="mt-3 text-end">
                    <form asp-controller="Cart" asp-action="ClearCart" method="post" onsubmit="return confirm('Sepeti tamamen boşaltmak istediğinize emin misiniz?');">
                        <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-x-circle me-1"></i> Sepeti Boşalt</button>
                    </form>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm border-0 bg-light">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-4 border-bottom pb-2">Sipariş Özeti</h5>
                        
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Ara Toplam:</span>
                            <span class="fw-medium">@grandTotal.ToString("C2")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3 border-bottom pb-3">
                            <span class="text-muted">Gönderim Ücreti:</span>
                            <span class="text-success fw-bold">Ücretsiz</span>
                        </div>
                        
                        <div class="d-flex justify-content-between mb-4">
                            <span class="fw-bold fs-5">Genel Toplam:</span>
                            <span class="fw-bold fs-4 text-primary">@grandTotal.ToString("C2")</span>
                        </div>

                        <div class="d-grid gap-2">
                            <a asp-controller="Cart" asp-action="Checkout" class="btn btn-success btn-lg fw-bold shadow-sm">
                                <i class="bi bi-credit-card me-2"></i> Ödemeye Geç
                            </a>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary mt-2">
                                <i class="bi bi-arrow-left me-1"></i> Alışverişe Devam Et
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>