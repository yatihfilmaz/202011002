@model project.Models.MenuItem
@{
    ViewData["Title"] = "Menü Yemeğini Düzenle";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-warning text-dark fw-bold py-3">
                    <i class="bi bi-pencil-square"></i> Düzenle: @Model.Title
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        
                        <input type="hidden" asp-for="ItemId" />
                        
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Title" class="form-label fw-bold">Yemek/Menü Adı</label>
                                <input asp-for="Title" class="form-control" required />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CategoryId" class="form-label fw-bold">Kategori</label>
                                <select asp-for="CategoryId" class="form-select" asp-items="@(new SelectList(ViewBag.Categories, "CategoryId", "Name", Model.CategoryId))" required>
                                    <option value="">Kategori Seçin...</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold">İçerik & Açıklama</label>
                            <textarea asp-for="Description" class="form-control" rows="3" required>@Model.Description</textarea>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label asp-for="Price" class="form-label fw-bold">Fiyat (₺)</label>
                                <input asp-for="Price" type="number" step="0.01" class="form-control" required />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="StockQuantity" class="form-label fw-bold">Stok Adedi</label>
                                <input asp-for="StockQuantity" type="number" class="form-control" required />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="ImageUrl" class="form-label fw-bold">Resim Linki (URL)</label>
                                <input asp-for="ImageUrl" class="form-control" placeholder="http://..." />
                            </div>
                        </div>

                        <div class="mb-4 bg-light p-3 border rounded d-flex justify-content-between flex-wrap gap-3">
                            <div class="form-check form-switch fs-5 mb-0">
                                <input class="form-check-input" type="checkbox" id="IsActiveSwitch" name="IsActive" value="true" 
                                       @(Model.IsActive == true ? "checked" : "") style="cursor:pointer;">
                                <input type="hidden" name="IsActive" value="false" />
                                <label class="form-check-label fw-bold text-success" for="IsActiveSwitch" style="cursor:pointer;">Müşterilere Göster</label>
                            </div>

                            <div class="form-check form-switch fs-5 mb-0">
                                <input class="form-check-input" type="checkbox" id="IsComboSwitch" name="IsCombo" value="true" @(Model.IsCombo ? "checked" : "") style="cursor:pointer;" onchange="toggleComboSelection(this.checked)">
                                <input type="hidden" name="IsCombo" value="false" />
                                <label class="form-check-label fw-bold text-warning" for="IsComboSwitch" style="cursor:pointer;"><i class="bi bi-star-fill"></i> Bu Bir Kombinasyon Menüsüdür</label>
                            </div>
                        </div>

                        <div id="comboItemsSection" class="mb-4 border p-3 rounded bg-white shadow-sm" style="display: @(Model.IsCombo ? "block" : "none");">
                            <label class="form-label fw-bold text-dark mb-2"><i class="bi bi-tags-fill text-primary"></i> Menünün İçeriğini Oluşturan Yemekleri Seçin:</label>
                            <div class="row g-2" style="max-height: 200px; overflow-y: auto;">
                                @if(ViewBag.AllSingleItems != null)
                                {
                                    @foreach (var singleItem in ViewBag.AllSingleItems as List<project.Models.MenuItem>)
                                    {
                                        bool isChecked = Model.ComboContents != null && Model.ComboContents.Any(cc => cc.SubItemId == singleItem.ItemId);
                                        <div class="col-md-6">
                                            <div class="form-check p-2 border rounded bg-light-subtle">
                                                <input class="form-check-input ms-1" type="checkbox" name="selectedSubItemIds" value="@singleItem.ItemId" id="subItem-@singleItem.ItemId" @(isChecked ? "checked" : "")>
                                                <label class="form-check-label ms-4 fw-medium" for="subItem-@singleItem.ItemId" style="cursor:pointer;">@singleItem.Title</label>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary fw-bold">
                                <i class="bi bi-arrow-left"></i> Geri Dön
                            </a>
                            <button type="submit" class="btn btn-success fw-bold px-4">
                                <i class="bi bi-save"></i> Değişiklikleri Kaydet
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Menü (Combo) switch'ine tıklandığında alt yemek seçme kutusunu gösterip/gizleyen fonksiyon
        function toggleComboSelection(isCombo) {
            document.getElementById('comboItemsSection').style.display = isCombo ? 'block' : 'none';
        }
    </script>
}