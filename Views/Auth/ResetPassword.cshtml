@model project.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Yeni Şifre Belirle";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0 rounded-lg mt-5">
                <div class="card-header text-center bg-white border-0 pt-4">
                    <h3 class="font-weight-light my-2" style="color: #198754;">Yeni Şifre Belirle</h3>
                    <p class="text-muted small">Lütfen hesabınız için yeni ve güvenli bir şifre oluşturun.</p>
                </div>
                <div class="card-body p-4">
                    
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger shadow-sm">@TempData["Error"]</div>
                    }

                    <form asp-action="ResetPassword" asp-controller="Auth" method="post">
                        <input type="hidden" asp-for="Token" />

                        <div class="form-floating mb-3">
                            <input asp-for="NewPassword" type="password" class="form-control" id="inputNewPassword" placeholder="Yeni Şifre" required />
                            <label for="inputNewPassword">Yeni Şifre</label>
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-4">
                            <input asp-for="ConfirmPassword" type="password" class="form-control" id="inputConfirmPassword" placeholder="Şifreyi Tekrar Girin" required />
                            <label for="inputConfirmPassword">Yeni Şifre (Tekrar)</label>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2 mt-4 mb-0">
                            <button type="submit" class="btn btn-success py-2 shadow-sm">
                                Şifremi Güncelle ve Kaydet
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>