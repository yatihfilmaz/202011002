@model List<project.Models.ChatMessage>
@{
    int currentUserId = ViewBag.CurrentUserId;
}

<div id="liveChatWidget" class="card shadow-lg border-0" style="position: fixed; bottom: 20px; right: 20px; width: 350px; height: 480px; z-index: 1050; display: flex; flex-direction: column; overflow: hidden; border-radius: 15px;">
    
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3">
        <div class="d-flex align-items-center">
            <div class="bg-white rounded-circle me-2 d-flex justify-content-center align-items-center" style="width:30px; height:30px;">
                <i class="bi bi-person-fill text-primary"></i>
            </div>
            <h6 class="mb-0 fw-bold">@ViewBag.OtherPartyName</h6>
        </div>
        <button type="button" class="btn-close btn-close-white" onclick="closeChatWidget()" aria-label="Kapat"></button>
    </div>
    
    <div class="card-body bg-light p-3" id="chatBox" style="overflow-y: auto; flex-grow: 1; display: flex; flex-direction: column;">
        @if(!Model.Any()) {
            <div class="text-center text-muted my-auto small" id="emptyChatMsg">
                <i class="bi bi-chat-square-quote fs-2 d-block mb-1"></i>
                Canlı destek başlatıldı. İlk mesajı siz gönderin!
            </div>
        }
        
        @foreach (var msg in Model) {
            bool isMe = msg.SenderId == currentUserId;
            <div class="mb-2 @(isMe ? "align-self-end text-end" : "align-self-start")" style="max-width: 85%;">
                <div class="px-3 py-2 rounded-3 shadow-sm d-inline-block @(isMe ? "bg-primary text-white" : "bg-white text-dark border")" style="text-align: left; font-size: 0.9rem;">
                    @msg.MessageText
                </div>
                <small class="text-muted d-block mt-1" style="font-size: 0.7rem;">@msg.SentAt.ToString("HH:mm")</small>
            </div>
        }
    </div>

    <div class="card-footer bg-white border-top-0 p-2">
        <div class="input-group">
            <input type="text" id="messageInput" class="form-control bg-light border-0" placeholder="Mesaj yazın..." autocomplete="off">
            <button class="btn btn-primary px-3 rounded-end" type="button" id="sendBtn"><i class="bi bi-send-fill"></i></button>
        </div>
    </div>
</div>

<script>
    // Eğer önceden açık bir bağlantı varsa çakışmayı önlemek için kapat
    if (window.chatConnection) { window.chatConnection.stop(); }

    var orderId = "@ViewBag.OrderId";
    var currentUserId = "@currentUserId";
    var chatBox = document.getElementById("chatBox");
    chatBox.scrollTop = chatBox.scrollHeight;

    window.chatConnection = new signalR.HubConnectionBuilder().withUrl("/chatHub").build();

    window.chatConnection.on("ReceiveMessage", function (senderId, senderName, message, time) {
        var emptyMsg = document.getElementById("emptyChatMsg");
        if (emptyMsg) emptyMsg.remove();
        
        var isMe = senderId === currentUserId;
        var alignClass = isMe ? "align-self-end text-end" : "align-self-start";
        var bgClass = isMe ? "bg-primary text-white" : "bg-white text-dark border";

        var msgHtml = `
            <div class="mb-2 ${alignClass}" style="max-width: 85%;">
                <div class="px-3 py-2 rounded-3 shadow-sm d-inline-block ${bgClass}" style="text-align: left; font-size: 0.9rem;">
                    ${message}
                </div>
                <small class="text-muted d-block mt-1" style="font-size: 0.7rem;">${time}</small>
            </div>
        `;
        chatBox.innerHTML += msgHtml;
        chatBox.scrollTop = chatBox.scrollHeight;
    });

    window.chatConnection.start().then(function () {
        window.chatConnection.invoke("JoinOrderChat", orderId);
    });

    document.getElementById("sendBtn").addEventListener("click", sendMessage);
    document.getElementById("messageInput").addEventListener("keypress", function (e) {
        if (e.key === 'Enter') sendMessage();
    });

    function sendMessage() {
        var input = document.getElementById("messageInput");
        var text = input.value.trim();
        if (text !== "") {
            window.chatConnection.invoke("SendMessage", orderId, text);
            input.value = "";
            input.focus();
        }
    }

    function closeChatWidget() {
        if (window.chatConnection) { window.chatConnection.stop(); }
        document.getElementById("liveChatWidget").remove(); // HTML'den sohbet kutusunu sil
    }
</script>