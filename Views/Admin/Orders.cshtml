@model List<project.Models.Order>
@{ ViewData["Title"] = "Siparişler (Tüm Sistem)"; }

<div class="container-fluid mt-4">
    <h3 class="mb-4"><i class="bi bi-card-list"></i> Sistemdeki Tüm Siparişler</h3>
    
    <div class="card shadow-sm border-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Sipariş No</th>
                    <th>Müşteri</th>
                    <th>Restoran</th>
                    <th>Tarih</th>
                    <th>Tutar</th>
                    <th>Durum</th>
                    <th class="text-center">İşlem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td class="fw-bold text-secondary">#@order.OrderId</td>
                        <td>@order.User?.FullName</td>
                        <td><span class="badge bg-light text-dark border">@order.Caterer?.FullName</span></td>
                        <td>@order.OrderDate?.ToString("dd MMM yyyy HH:mm")</td>
                        <td class="fw-bold text-primary">@order.TotalAmount.ToString("C2")</td>
                        <td>
                            @{ var bClass = order.Status == "Tamamlandı" ? "bg-success" : (order.Status == "İptal Edildi" ? "bg-danger" : "bg-warning text-dark"); }
                            <span class="badge @bClass">@order.Status</span>
                        </td>
                        <td class="text-center">
                            <button type="button" class="btn btn-sm btn-outline-dark fw-bold" onclick="openOrderDetailsModal(@order.OrderId)">
                                <i class="bi bi-eye-fill"></i> İncele
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="orderDetailsModal" tabindex="-1" aria-labelledby="orderDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content shadow border-0" id="orderDetailsDynamicContent">
            </div>
    </div>
</div>

@section Scripts {
    <script>
        function openOrderDetailsModal(orderId) {
            // Yükleniyor animasyonu yerleştirme
            $("#orderDetailsDynamicContent").html('<div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div><p class="mt-2 text-muted">Sipariş detayları getiriliyor...</p></div>');
            
            // Modalı göster
            var detailsModal = new bootstrap.Modal(document.getElementById('orderDetailsModal'));
            detailsModal.show();
            
            // Arka planda controller aksiyonundan HTML içeriğini çekme
            $.get("/Admin/GetOrderDetails/" + orderId, function (data) {
                $("#orderDetailsDynamicContent").html(data);
            }).fail(function () {
                $("#orderDetailsDynamicContent").html('<div class="alert alert-danger m-3 text-center">Sipariş detayları yüklenirken bir hata oluştu.</div>');
            });
        }
    </script>
}