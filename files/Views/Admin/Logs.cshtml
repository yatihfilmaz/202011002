@model List<project.Models.SystemLog>
@{ ViewData["Title"] = "Sistem Logları"; }

<div class="container-fluid mt-4">
    <h3 class="mb-4"><i class="bi bi-file-earmark-code"></i> Sistem Logları (Access & Activity Logs)</h3>
    <p class="text-muted">Platform üzerindeki tüm şifre yenileme, giriş yapma, sipariş statü değişimi ve admin onay işlemleri burada kayıt altına alınır.</p>
    
    <div class="card shadow-sm border-0">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
            <tr>
                <th>Tarih (Timestamp)</th>
                <th>Kullanıcı (User)</th>
                <th>Aksiyon Tipi</th>
                <th>Detay (Description)</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var log in Model)
            {
                <tr>
                    <td class="text-muted">@log.Timestamp?.ToString("dd.MM.yyyy HH:mm:ss")</td>
                    <td class="fw-bold">@(log.User?.FullName ?? "SİSTEM") <br/><small class="text-muted fw-normal">ID: @log.UserId</small></td>
                    <td><span class="badge bg-info text-dark">@log.ActionType</span></td>
                    <td>@log.Description</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>