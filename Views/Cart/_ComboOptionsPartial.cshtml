@model project.Models.MenuItem
@{
    var subItems = ViewBag.SubItems as List<project.Models.MenuItem>;
}

<div class="modal-header bg-primary text-white">
    <h5 class="modal-title fw-bold">
        <i class="bi bi-box-seam me-2"></i> @Model.Title
    </h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
</div>

<form asp-controller="Cart" asp-action="AddToCart" method="post">
    <input type="hidden" name="itemId" value="@Model.ItemId" />
    
    <div class="modal-body p-4" style="max-height: 70vh; overflow-y: auto;">
        <p class="text-muted small mb-3">Menü içeriğindeki ürünlerin ek malzemelerini ve seçeneklerini aşağıdan belirleyebilirsiniz.</p>

        @if (subItems != null && subItems.Any())
        {
            foreach (var subItem in subItems)
            {
                <div class="card mb-3 border border-light-subtle shadow-sm rounded-3">
                    <div class="card-header bg-light fw-bold text-dark py-2 small d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-egg-fried text-primary me-1"></i> @subItem.Title Detayları</span>
                        <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary-subtle">Menü İçeriği</span>
                    </div>
                    <div class="card-body py-1">
    @if (subItem.Customizations != null && subItem.Customizations.Any())
    {
        // Seçenekleri gruplarına göre ayırıyoruz (Örn: İçecekler, Ekstra Malzemeler)
        var optionGroups = subItem.Customizations.GroupBy(c => c.OptionGroup ?? "Seçenekler");
        
        foreach (var group in optionGroups)
        {
            // Bu grubun tekli seçim (Radio) mi yoksa çoklu seçim (Checkbox) mi olduğunu belirliyoruz
            bool isSingle = group.FirstOrDefault()?.IsSingleSelect ?? false;
            
            // HTML input tipini ayarlıyoruz
            string inputType = isSingle ? "radio" : "checkbox";
            
            // CartController'ın radio butonları doğru yakalayabilmesi için name niteliğini "SelectedOptions_" ile başlatıyoruz.
            // Checkbox'lar ise varsayılan "selectedOptionIds" listesine gidiyor.
            string inputName = isSingle ? $"SelectedOptions_{subItem.ItemId}_{group.Key.Replace(" ", "")}" : "selectedOptionIds";

            <div class="my-2">
                <small class="text-primary fw-bold d-block mb-1 border-bottom pb-1" style="font-size: 0.8rem;">
                    @group.Key @(isSingle ? "(Tek Seçim)" : "(Çoklu Seçim)")
                </small>
                
                @foreach (var opt in group)
                {
                    <div class="form-check my-2">
                        <input class="form-check-input" type="@inputType" name="@inputName" value="@opt.OptionId" id="opt_combo_@opt.OptionId">
                        <label class="form-check-label d-flex justify-content-between w-100 ps-1" for="opt_combo_@opt.OptionId" style="font-size: 0.9rem; cursor: pointer;">
                            <span class="text-secondary">@opt.Name</span>
                            @if (opt.PriceChange > 0)
                            {
                                <span class="text-success fw-bold small">+@opt.PriceChange?.ToString("C2")</span>
                            }
                        </label>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <p class="text-muted small my-2 ps-1 fst-italic">Bu ürün için seçilebilir ekstra bir seçenek bulunmuyor.</p>
    }
</div>
                </div>
            }
        }
        
        <div class="mt-4 pt-3 border-top d-flex align-items-center justify-content-between">
            <span class="fw-bold text-dark"><i class="bi bi-pin-fill text-primary"></i> Menü Adedi:</span>
            <div class="input-group" style="width: 130px;">
                <button class="btn btn-outline-secondary btn-sm" type="button" onclick="decrementComboQty()">-</button>
                <input type="number" name="quantity" id="comboQuantityInput" class="form-control form-control-sm text-center fw-bold" value="1" min="1" max="@Model.StockQuantity" readonly />
                <button class="btn btn-outline-secondary btn-sm" type="button" onclick="incrementComboQty()">+</button>
            </div>
        </div>
    </div>

    <div class="modal-footer bg-light border-0">
        <button type="button" class="btn btn-sm btn-light fw-bold" data-bs-dismiss="modal">Vazgeç</button>
        <button type="submit" class="btn btn-sm btn-primary fw-bold px-4 shadow"><i class="bi bi-cart-plus"></i> Menüyü Sepete Ekle</button>
    </div>
</form>

<script>
    function incrementComboQty() {
        var input = document.getElementById('comboQuantityInput');
        var max = parseInt(input.getAttribute('max')) || 99;
        var val = parseInt(input.value);
        if(val < max) input.value = val + 1;
    }
    function decrementComboQty() {
        var input = document.getElementById('comboQuantityInput');
        var val = parseInt(input.value);
        if(val > 1) input.value = val - 1;
    }
</script>