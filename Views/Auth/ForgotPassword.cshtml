@{
    ViewData["Title"] = "Şifremi Unuttum";
    // Eğer Auth sayfaları için özel bir Layout kullanıyorsan buraya yazabilirsin, yoksa boş kalabilir.
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0 rounded-lg mt-5">
                <div class="card-header text-center bg-white border-0 pt-4">
                    <h3 class="font-weight-light my-2" style="color: #0d6efd;">Şifremi Unuttum</h3>
                    <p class="text-muted small">E-posta adresinizi girin, size şifrenizi sıfırlamanız için bir bağlantı gönderelim.</p>
                </div>
                <div class="card-body p-4">
                    
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger shadow-sm">@TempData["Error"]</div>
                    }

                    <form asp-action="ForgotPassword" asp-controller="Auth" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>
                        
                        <div class="form-floating mb-4">
                            <input type="email" name="email" class="form-control" id="inputEmail" placeholder="name@example.com" required />
                            <label for="inputEmail">E-Posta Adresi</label>
                        </div>
                        
                        <div class="d-flex align-items-center justify-content-between mt-4 mb-0">
                            <a class="small text-decoration-none" asp-action="Login" asp-controller="Auth">
                                <i class="bi bi-arrow-left"></i> Giriş Ekranına Dön
                            </a>
                            <button type="submit" class="btn btn-primary px-4 shadow-sm">Sıfırlama Linki Gönder</button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>